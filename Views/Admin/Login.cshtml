
@{
    Layout = null;
    ViewBag.Title = "Đăng nhập quản trị";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin Login - SmartBook</title>

    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <style>

        <style >
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Be Vietnam Pro', sans-serif;
            background: linear-gradient(135deg, #183b36, #39766b);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .login-container {
            background: #fff;
            width: 100%;
            max-width: 430px;
            padding: 42px 38px;
            border-radius: 18px;
            box-shadow: 0 15px 45px rgba(0,0,0,0.2);
        }

        .logo {
            text-align: center;
            font-size: 30px;
            font-weight: 800;
            color: #183b36;
            margin-bottom: 8px;
        }

            .logo span {
                color: #39766b;
            }

        .subtitle {
            text-align: center;
            color: #78918b;
            font-size: 13px;
            margin-bottom: 30px;
        }

        h2 {
            text-align: center;
            color: #183b36;
            font-size: 21px;
            margin-bottom: 25px;
        }

        .form-group {
            margin-bottom: 19px;
        }

        label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: #294d45;
            margin-bottom: 8px;
        }

        input {
            width: 100%;
            padding: 13px 14px;
            border: 1px solid #d5e3de;
            border-radius: 8px;
            font-family: inherit;
            font-size: 14px;
            outline: none;
            transition: 0.2s;
        }

            input:focus {
                border-color: #39766b;
                box-shadow: 0 0 0 3px rgba(57,118,107,0.12);
            }

        .btn-login {
            width: 100%;
            padding: 14px;
            background: #39766b;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            margin-top: 8px;
            transition: 0.2s;
        }

            .btn-login:hover {
                background: #183b36;
            }

        .error {
            color: #b83232;
            background: #fff0ee;
            padding: 11px;
            border-radius: 7px;
            font-size: 13px;
            margin-bottom: 17px;
            text-align: center;
        }

        .back-link {
            display: block;
            text-align: center;
            margin-top: 22px;
            color: #78918b;
            text-decoration: none;
            font-size: 13px;
        }

            .back-link:hover {
                color: #39766b;
            }
    </style>

    </style>
</head>

<body>
    <div class="login-container">

        <div class="logo">Smart<span>Book</span></div>

        <p class="subtitle">HỆ THỐNG QUẢN TRỊ CỬA HÀNG SÁCH</p>

        <h2>Đăng nhập Admin</h2>

        @if (ViewBag.Error != null)
        {
            <div class="error">@ViewBag.Error</div>
        }

        @using (Html.BeginForm("Login", "Admin", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Tên đăng nhập</label>
                <input type="text"
                       name="username"
                       placeholder="Nhập tên đăng nhập"
                       required />
            </div>

            <div class="form-group">
                <label>Mật khẩu</label>
                <input type="password"
                       name="password"
                       placeholder="Nhập mật khẩu"
                       required />
            </div>

            <button type="submit" class="btn-login">
                ĐĂNG NHẬP
            </button>
        }

        <a href="@Url.Action("Index", "Home")" class="back-link">
            ← Quay lại trang chủ SmartBook
        </a>

    </div>
</body>
</html>
