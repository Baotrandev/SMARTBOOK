
@{
    var currentController = ViewContext.RouteData.Values["controller"] != null
        ? ViewContext.RouteData.Values["controller"].ToString()
        : "";

    bool isDashboard = currentController == "Admin";
    bool isBooks = currentController == "AdminBooks";
    bool isOrders = currentController == "AdminOrders";
    bool isReviews = currentController == "AdminReviews";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewBag.Title - SmartBook Admin</title>

    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Be Vietnam Pro', sans-serif;
            background: #f3f7f5;
            color: #263c36;
            min-height: 100vh;
        }

        a {
            text-decoration: none;
        }

        /* =========================
           ADMIN LAYOUT
        ========================= */

        .admin-wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* =========================
           SIDEBAR
        ========================= */

        .sidebar {
            width: 255px;
            background: #183b36;
            color: #fff;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            padding: 27px 17px;
            overflow-y: auto;
            overflow-x: hidden;
            z-index: 1000;
        }

        .brand {
            text-align: center;
            font-size: 25px;
            font-weight: 800;
            margin-bottom: 8px;
            color: #fff;
            letter-spacing: -.7px;
        }

            .brand span {
                color: #91c5ae;
            }

        .sidebar-subtitle {
            text-align: center;
            color: #b7d0c7;
            font-size: 10px;
            letter-spacing: 1.2px;
            margin-bottom: 35px;
        }

        .menu-title {
            color: #9bbab0;
            font-size: 10px;
            font-weight: 700;
            margin: 22px 12px 10px;
            letter-spacing: 1px;
        }

        .menu a {
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 13px 14px;
            margin: 5px 0;
            color: #dce9e4;
            font-size: 13px;
            font-weight: 500;
            border-radius: 8px;
            transition: all .2s ease;
        }

            .menu a:hover,
            .menu a.active {
                background: #39766b;
                color: #fff;
            }

            .menu a.active {
                font-weight: 700;
            }

            .menu a i {
                width: 19px;
                text-align: center;
                font-size: 14px;
                flex-shrink: 0;
            }

        /* =========================
           MAIN CONTENT
        ========================= */

        .main-content {
            margin-left: 255px;
            width: calc(100% - 255px);
            min-width: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* =========================
           TOPBAR
        ========================= */

        .topbar {
            height: 75px;
            min-height: 75px;
            background: #fff;
            padding: 0 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #e5ece8;
            position: sticky;
            top: 0;
            z-index: 900;
        }

            .topbar h3 {
                font-size: 17px;
                font-weight: 700;
                color: #183b36;
            }

        .admin-user {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 13px;
            font-weight: 600;
            color: #263c36;
        }

        .admin-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #dcece5;
            color: #39766b;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        /* =========================
           PAGE CONTENT
        ========================= */

        .content {
            flex: 1;
            padding: 30px 32px;
            width: 100%;
            min-width: 0;
        }

        .page-heading {
            margin-bottom: 25px;
        }

            .page-heading h2 {
                color: #183b36;
                font-size: 23px;
                font-weight: 800;
                margin-bottom: 7px;
            }

            .page-heading p {
                color: #82938c;
                font-size: 13px;
                line-height: 1.6;
            }

        /* =========================
           FOOTER
        ========================= */

        .admin-footer {
            padding: 20px 32px;
            color: #91a39b;
            font-size: 11px;
            border-top: 1px solid #e5ece8;
            background: #fff;
        }

        /* =========================
           LOGOUT
        ========================= */

        .logout-link {
            margin-top: 30px !important;
            border: 1px solid rgba(255,255,255,.15);
        }

            .logout-link:hover {
                background: #a94442 !important;
                border-color: #a94442;
            }

        /* =========================
           GENERAL CONTENT
        ========================= */

        .content img {
            max-width: 100%;
        }

        .content table {
            max-width: 100%;
        }

        /* =====================================
           ADMIN BOOKS - QUẢN LÝ SÁCH
        ===================================== */

        .admin-books-page {
            width: 100%;
            min-width: 0;
        }

            .admin-books-page .page-heading {
                margin-bottom: 22px;
            }

                .admin-books-page .page-heading h2 {
                    font-size: 25px;
                    font-weight: 800;
                    color: #183b36;
                    margin-bottom: 8px;
                }

                .admin-books-page .page-heading p {
                    font-size: 13px;
                    color: #82938c;
                }

            /* Nút thêm sách */

            .admin-books-page .btn-add-book {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                padding: 11px 18px;
                margin-bottom: 20px;
                background: #39766b;
                color: #fff;
                border-radius: 9px;
                font-size: 13px;
                font-weight: 600;
                border: none;
                transition: .2s;
            }

                .admin-books-page .btn-add-book:hover {
                    background: #183b36;
                    color: #fff;
                    transform: translateY(-1px);
                }

            /* Tìm kiếm */

            .admin-books-page .book-search {
                display: flex;
                align-items: center;
                gap: 10px;
                margin-bottom: 22px;
                padding: 16px;
                background: #fff;
                border: 1px solid #e5ece8;
                border-radius: 12px;
            }

                .admin-books-page .book-search input {
                    flex: 1;
                    min-width: 0;
                    height: 43px;
                    padding: 0 14px;
                    border: 1px solid #dce6e1;
                    border-radius: 8px;
                    outline: none;
                    font-family: inherit;
                    font-size: 13px;
                }

                    .admin-books-page .book-search input:focus {
                        border-color: #39766b;
                        box-shadow: 0 0 0 3px rgba(57,118,107,.10);
                    }

            .admin-books-page .btn-search {
                height: 43px;
                padding: 0 20px;
                border: none;
                border-radius: 8px;
                background: #183b36;
                color: #fff;
                font-family: inherit;
                font-size: 13px;
                font-weight: 600;
                cursor: pointer;
                white-space: nowrap;
            }

                .admin-books-page .btn-search:hover {
                    background: #39766b;
                }

            /* Bảng sách */

            .admin-books-page .book-table-wrapper {
                width: 100%;
                overflow-x: auto;
                background: #fff;
                border: 1px solid #e5ece8;
                border-radius: 12px;
                box-shadow: 0 3px 12px rgba(24,59,54,.04);
            }

            .admin-books-page .book-table {
                width: 100%;
                min-width: 850px;
                border-collapse: collapse;
                background: #fff;
                font-size: 13px;
            }

                .admin-books-page .book-table thead {
                    background: #eaf2ee;
                }

                .admin-books-page .book-table th {
                    padding: 16px 13px;
                    color: #183b36;
                    font-weight: 700;
                    text-align: left;
                    white-space: nowrap;
                    border-bottom: 1px solid #dce8e2;
                }

                .admin-books-page .book-table td {
                    padding: 12px 13px;
                    color: #465a52;
                    vertical-align: middle;
                    border-bottom: 1px solid #edf1ee;
                }

                .admin-books-page .book-table tbody tr:hover {
                    background: #f7faf8;
                }

                .admin-books-page .book-table tbody tr:last-child td {
                    border-bottom: none;
                }

                .admin-books-page .book-table .book-id {
                    width: 65px;
                    text-align: center;
                    font-weight: 600;
                }

                .admin-books-page .book-table .book-image {
                    width: 65px;
                    height: 85px;
                    object-fit: cover;
                    border-radius: 5px;
                    border: 1px solid #e5ece8;
                    display: block;
                }

                .admin-books-page .book-table .book-name {
                    min-width: 190px;
                    font-weight: 600;
                    color: #263c36;
                }

                .admin-books-page .book-table .book-isbn {
                    white-space: nowrap;
                }

                .admin-books-page .book-table .book-price {
                    white-space: nowrap;
                    font-weight: 700;
                    color: #39766b;
                }

                .admin-books-page .book-table .book-status {
                    display: inline-block;
                    padding: 5px 10px;
                    border-radius: 20px;
                    background: #e5f3eb;
                    color: #28734e;
                    font-size: 11px;
                    font-weight: 600;
                    white-space: nowrap;
                }

            /* Thao tác */

            .admin-books-page .book-actions {
                display: flex;
                align-items: center;
                gap: 7px;
                white-space: nowrap;
            }

                .admin-books-page .book-actions a {
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    gap: 5px;
                    padding: 7px 10px;
                    border-radius: 6px;
                    font-size: 11px;
                    font-weight: 600;
                    transition: .2s;
                }

            .admin-books-page .action-detail {
                background: #e8f1f8;
                color: #28618b;
            }

            .admin-books-page .action-edit {
                background: #fff4df;
                color: #a66a12;
            }

            .admin-books-page .action-delete {
                background: #fcebea;
                color: #b54740;
            }

            .admin-books-page .book-actions a:hover {
                filter: brightness(.95);
            }

            /* Phân trang */

            .admin-books-page .pagination {
                display: flex;
                justify-content: center;
                align-items: center;
                gap: 7px;
                margin-top: 22px;
                flex-wrap: wrap;
            }

        /* =====================================
           RESPONSIVE - TABLET
        ===================================== */

        @@media (max-width: 992px) {
            .sidebar {
                width: 220px;
            }

            .main-content {
                margin-left: 220px;
                width: calc(100% - 220px);
            }

            .content {
                padding: 25px 20px;
            }

            .topbar {
                padding: 0 20px;
            }
        }

        /* =====================================
           RESPONSIVE - BOOK TABLE
        ===================================== */

        /* Responsive */
       @@media (max-width: 576px) {
       .admin-books-page .book-search {
        flex-direction: column;
       }

       .admin-books-page .btn-search {
        width: 100%;
       }

        .admin-books-page .page-heading h2 {
        font-size: 20px;
       }
       }
        /* =====================================
           RESPONSIVE - MOBILE
        ===================================== */

        @@media (max-width: 768px) {
            .sidebar {
                width: 72px;
                padding: 20px 8px;
            }

            .brand {
                font-size: 16px;
                letter-spacing: 0;
            }

            .sidebar-subtitle,
            .menu-title,
            .menu a span {
                display: none;
            }

            .menu a {
                justify-content: center;
                padding: 14px 5px;
                gap: 0;
            }

                .menu a i {
                    font-size: 17px;
                }

            .main-content {
                margin-left: 72px;
                width: calc(100% - 72px);
            }

            .content {
                padding: 20px 15px;
            }

            .topbar {
                height: 65px;
                min-height: 65px;
                padding: 0 15px;
            }

                .topbar h3 {
                    font-size: 14px;
                }

            .admin-user {
                font-size: 11px;
            }

            .admin-avatar {
                width: 34px;
                height: 34px;
            }

            .admin-footer {
                padding: 15px;
            }
        }

        @@media (max-width: 480px) {
            .admin-user span {
                display: none;
            }

            .content {
                padding: 15px 10px;
            }

            .page-heading h2 {
                font-size: 19px;
            }
        }
        /* Đồng bộ font chữ toàn bộ giao diện Admin */
        body,
        body button,
        body input,
        body a {
            font-family: 'Be Vietnam Pro', sans-serif !important;
        }

        /* Nút thêm sách mới */
        .btn-add-book {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 12px 20px;
            background: #39766b;
            color: #ffffff !important;
            border: none;
            border-radius: 9px;
            font-family: inherit !important;
            font-size: 14px !important;
            font-weight: 600 !important;
            font-style: normal;
            letter-spacing: 0;
            text-transform: none;
            text-decoration: none !important;
            white-space: nowrap;
            transition: .2s ease;
        }

            .btn-add-book:hover {
                background: #183b36;
                color: #ffffff !important;
                text-decoration: none !important;
            }
    </style>

    @RenderSection("styles", required: false)
</head>

<body>
    <div class="admin-wrapper">

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <div class="brand">
                Smart<span>Book</span>
            </div>

            <div class="sidebar-subtitle">
                ADMINISTRATION SYSTEM
            </div>

            <nav class="menu">

                <div class="menu-title">TỔNG QUAN</div>

                <a href="@Url.Action("Dashboard", "Admin")"
                   class="@(isDashboard ? "active" : "")">
                    <i class="fa-solid fa-chart-pie"></i>
                    <span>Dashboard</span>
                </a>

                <div class="menu-title">QUẢN LÝ CỬA HÀNG</div>

                <a href="@Url.Action("Index", "AdminBooks")"
                   class="@(isBooks ? "active" : "")">
                    <i class="fa-solid fa-book"></i>
                    <span>Quản lý sách</span>
                </a>

                <a href="@Url.Action("Index", "AdminOrders")"
                   class="@(isOrders ? "active" : "")">
                    <i class="fa-solid fa-cart-shopping"></i>
                    <span>Quản lý đơn hàng</span>
                </a>

                <a href="@Url.Action("Index", "AdminReviews")"
                   class="@(isReviews ? "active" : "")">
                    <i class="fa-solid fa-star"></i>
                    <span>Đánh giá cửa hàng</span>
                </a>

                <div class="menu-title">THỐNG KÊ</div>

                <a href="@Url.Action("Dashboard", "Admin")#revenue">
                    <i class="fa-solid fa-chart-line"></i>
                    <span>Doanh thu</span>
                </a>

                <a href="@Url.Action("Dashboard", "Admin")#purchases">
                    <i class="fa-solid fa-bag-shopping"></i>
                    <span>Lượt mua</span>
                </a>

                <a href="@Url.Action("Logout", "Admin")"
                   class="logout-link">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    <span>Đăng xuất</span>
                </a>

            </nav>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">

            <header class="topbar">
                <h3>Khu vực quản trị</h3>

                <div class="admin-user">
                    <div class="admin-avatar">
                        <i class="fa-solid fa-user-shield"></i>
                    </div>

                    <span>
                        @(Session["AdminName"] ?? "Quản trị viên SmartBook")
                    </span>
                </div>
            </header>

            <section class="content">
                @RenderBody()
            </section>

            <footer class="admin-footer">
                © @DateTime.Now.Year SmartBook.
                Hệ thống quản trị cửa hàng sách.
            </footer>

        </main>
    </div>

    @RenderSection("scripts", required: false)
</body>
</html>
