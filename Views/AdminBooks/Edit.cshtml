
@model SmartBook.Models.book

@{
    ViewBag.Title = "Chỉnh sửa sách";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>CHỈNH SỬA THÔNG TIN SÁCH</h2>
    <hr />

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.book_id)

        @Html.ValidationSummary(false, "", new { @class = "text-danger" })

        <div class="form-group mb-3">
            <label>Tên sách</label>
            @Html.TextBoxFor(m => m.book_title,
                     new { @class = "form-control" })
        </div>

        <div class="form-group mb-3">
            <label>ISBN</label>
            @Html.TextBoxFor(m => m.ISBN,
                     new { @class = "form-control" })
        </div>

        <div class="form-group mb-3">
            <label>Danh mục</label>
            @Html.DropDownListFor(m => m.category_id,
                     (SelectList)ViewBag.CategoryList,
                     "-- Chọn danh mục --",
                     new { @class = "form-control" })
        </div>

        <div class="form-group mb-3">
            <label>Nhà xuất bản</label>
            @Html.DropDownListFor(m => m.publisher_id,
                     (SelectList)ViewBag.PublisherList,
                     "-- Chọn nhà xuất bản --",
                     new { @class = "form-control" })
        </div>

        <div class="form-group mb-3">
            <label>Mô tả</label>
            @Html.TextAreaFor(m => m.description,
                     new { @class = "form-control", rows = "4" })
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label>Giá gốc</label>
                @Html.TextBoxFor(m => m.original_price,
                         new { @class = "form-control", type = "number", min = "0", step = "1000" })
            </div>

            <div class="col-md-6 mb-3">
                <label>Giá bán</label>
                @Html.TextBoxFor(m => m.sale_price,
                         new { @class = "form-control", type = "number", min = "0", step = "1000" })
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label>Ngày xuất bản</label>
                @Html.TextBoxFor(m => m.publication_date,
                         "{0:yyyy-MM-dd}",
                         new { @class = "form-control", type = "date" })
            </div>

            <div class="col-md-6 mb-3">
                <label>Số trang</label>
                @Html.TextBoxFor(m => m.page_count,
                         new { @class = "form-control", type = "number", min = "1" })
            </div>
        </div>

        <div class="form-group mb-3">
            <label>Ngôn ngữ</label>
            @Html.TextBoxFor(m => m.language,
                     new { @class = "form-control" })
        </div>

        <div class="form-group mb-3">
            <label>Hình thức</label>
            @Html.TextBoxFor(m => m.book_format,
                     new { @class = "form-control" })
        </div>

        <div class="form-group mb-3">
            <label>Ảnh bìa</label>
            @Html.TextBoxFor(m => m.cover_image_url,
                     new { @class = "form-control" })
        </div>

        <div class="form-group mb-3">
            <label>Trạng thái</label>
            @Html.DropDownListFor(m => m.status,
                     new SelectList(new[]
                     {
                    "Dang ban",
                    "Ngung kinh doanh",
                    "Het hang"
                         }, Model.status),
                     "-- Chọn trạng thái --",
                     new { @class = "form-control" })
        </div>

        <button type="submit" class="btn btn-success">
            Cập nhật sách
        </button>

        @Html.ActionLink("Quay lại", "Index", null,
                 new { @class = "btn btn-secondary" })
    }
</div>
