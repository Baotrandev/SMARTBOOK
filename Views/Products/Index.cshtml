
@model IEnumerable<SmartBook.Models.book>

@using System.Collections.Generic
@using System.Linq

@{
    ViewBag.Title = "Sách - SmartBook";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var categories = ViewBag.Categories as IEnumerable<SmartBook.Models.category>;
    int? selectedCategory = ViewBag.SelectedCategory;

    var authorsByBook = ViewBag.AuthorsByBook as Dictionary<int, string>;
}

<style>
    .books-page {
        max-width: 1250px;
        margin: 35px auto;
        padding: 0 20px;
        color: #24463c;
        font-family: 'Be Vietnam Pro', sans-serif;
    }

    /* Banner giới thiệu */
    .books-hero {
        background: linear-gradient(120deg, #173f37, #39796a);
        color: white;
        border-radius: 18px;
        padding: 55px 50px;
        margin-bottom: 45px;
        position: relative;
        overflow: hidden;
    }

        .books-hero small {
            color: #f5d889;
            letter-spacing: 3px;
            font-weight: 700;
        }

        .books-hero h1 {
            font-size: 38px;
            font-weight: 800;
            margin: 18px 0;
        }

        .books-hero p {
            max-width: 650px;
            line-height: 1.9;
            font-size: 16px;
        }

    .hero-quote {
        color: #f5d889;
        font-size: 19px;
        font-style: italic;
        margin-top: 25px;
    }

    /* Banner sale */
    .sale-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        min-height: 280px;
        padding: 45px 55px;
        margin: 35px 0 45px;
        border-radius: 20px;
        overflow: hidden;
        color: white;
        background: linear-gradient(120deg, #183b36, #39766b);
        box-shadow: 0 12px 30px rgba(24, 59, 54, .15);
    }

    .sale-content {
        max-width: 620px;
    }

    .sale-label {
        display: inline-block;
        padding: 8px 16px;
        border-radius: 30px;
        background: #f5d88b;
        color: #183b36;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 2px;
    }

    .sale-content h2 {
        color: white;
        font-size: 42px;
        font-weight: 900;
        margin: 17px 0 10px;
    }

        .sale-content h2 span {
            color: #f5d88b;
        }

    .sale-content p {
        color: #edf5f1;
        font-size: 16px;
        line-height: 1.8;
        margin-bottom: 22px;
    }

    .sale-button {
        display: inline-block;
        padding: 13px 25px;
        border-radius: 8px;
        background: #f5d88b;
        color: #183b36;
        font-weight: 800;
        text-decoration: none;
    }

        .sale-button:hover {
            background: white;
            color: #183b36;
            text-decoration: none;
        }

    .sale-percent {
        min-width: 190px;
        text-align: center;
        font-size: 105px;
        line-height: 1;
        font-weight: 900;
        color: #f5d88b;
        text-shadow: 4px 7px 0 rgba(0,0,0,.12);
    }

        .sale-percent small {
            display: block;
            font-size: 25px;
            letter-spacing: 5px;
            color: white;
            margin-top: 12px;
        }

    /* Tiêu đề */
    .books-heading {
        margin-bottom: 25px;
    }

        .books-heading h2 {
            font-size: 29px;
            font-weight: 800;
            color: #173f37;
        }

        .books-heading p {
            color: #888;
        }

    /* Danh mục */
    .category-list {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin: 25px 0 45px;
    }

    .category-item {
        padding: 12px 21px;
        border: 1px solid #dce8e2;
        border-radius: 30px;
        color: #28594b;
        background: #f7faf8;
        text-decoration: none;
        font-weight: 600;
        transition: .25s;
    }

        .category-item:hover,
        .category-item.active {
            background: #204e43;
            color: white;
            border-color: #204e43;
            text-decoration: none;
        }

    /* Thông điệp */
    .category-message {
        background: #f7f5ed;
        border-left: 5px solid #d7b45f;
        border-radius: 9px;
        padding: 20px 25px;
        margin-bottom: 25px;
    }

        .category-message .quote {
            color: #31594d;
            font-size: 18px;
            font-weight: 600;
            font-style: italic;
        }

        .category-message p {
            color: #777;
            margin: 9px 0 0;
        }

    /* Danh sách sách */
    .book-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 22px;
    }

    .book-card {
        border: 1px solid #e8eeea;
        border-radius: 14px;
        overflow: hidden;
        background: white;
        transition: .3s;
    }

        .book-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 28px rgba(0,0,0,.09);
        }

    /* Mỗi sách chỉ có một khung ảnh */
    .book-cover {
        height: 250px;
        padding: 15px;
        background: #f7f8f5;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .book-cover img {
            display: block;
            max-width: 100%;
            max-height: 100%;
            width: auto;
            height: auto;
            object-fit: contain;
        }

    .book-detail {
        padding: 17px;
    }

        .book-detail h4 {
            font-size: 16px;
            font-weight: 700;
            color: #24463c;
            line-height: 1.5;
            min-height: 48px;
        }

    .book-author {
        display: flex;
        align-items: center;
        gap: 7px;
        margin: 8px 0 12px;
        color: #8a7968;
        font-size: 13px;
        min-height: 20px;
    }

        .book-author i {
            color: #b18b58;
            font-size: 12px;
        }

    .book-description {
        color: #888;
        font-size: 13px;
        min-height: 40px;
        line-height: 1.5;
    }

    .book-price {
        color: #c45b42;
        font-size: 19px;
        font-weight: 800;
        margin: 12px 0;
    }

    .book-original-price {
        color: #999;
        font-size: 13px;
        text-decoration: line-through;
    }

    .discount-label {
        display: inline-block;
        margin-top: 9px;
        padding: 5px 9px;
        border-radius: 5px;
        background: #c83d32;
        color: white;
        font-size: 12px;
        font-weight: 700;
    }

    .book-actions {
        display: flex;
        flex-direction: column;
        gap: 9px;
        margin-top: 15px;
    }

        .book-actions form {
            margin: 0;
        }

    .add-cart-btn {
        display: block;
        width: 100%;
        padding: 11px;
        border: 1px solid #39796a;
        border-radius: 7px;
        background: #39796a;
        color: white;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: .25s;
    }

        .add-cart-btn:hover {
            background: #173f37;
            border-color: #173f37;
        }

        .add-cart-btn i {
            margin-right: 6px;
        }

    .book-button {
        display: block;
        background: #204e43;
        color: white;
        padding: 11px;
        text-align: center;
        border-radius: 7px;
        text-decoration: none;
        font-weight: 600;
        margin-top: 13px;
    }

        .book-button:hover {
            background: #39796a;
            color: white;
            text-decoration: none;
        }

    .book-actions .book-button {
        margin-top: 0;
    }

    /* Tiêu đề thể loại */
    .category-title {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #e5ebe7;
        margin-bottom: 22px;
        padding-bottom: 12px;
    }

        .category-title h3 {
            font-size: 24px;
            font-weight: 800;
            color: #204e43;
        }

        .category-title span {
            color: #999;
            font-size: 13px;
        }

    .book-section {
        margin-bottom: 55px;
        scroll-margin-top: 30px;
    }

    .empty-books {
        text-align: center;
        background: #f7faf8;
        padding: 40px;
        border-radius: 12px;
        color: #777;
    }

    /* Responsive */
    @@media (max-width: 992px) {
        .book-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .book-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
        }

        .book-cover {
            height: 190px;
        }

        .books-hero {
            padding: 35px 25px;
        }

            .books-hero h1 {
                font-size: 27px;
            }

        .sale-banner {
            padding: 35px 25px;
            flex-direction: column;
            align-items: flex-start;
        }

        .sale-content h2 {
            font-size: 30px;
        }

        .sale-percent {
            font-size: 75px;
            align-self: center;
        }
    }

    @@media (max-width: 480px) {
        .book-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
        }

        .books-page {
            padding: 0 10px;
        }

        .book-detail {
            padding: 12px;
        }
    }
</style>

<div class="books-page">

    <!-- Banner sale -->
    <section class="sale-banner">
        <div class="sale-content">
            <span class="sale-label">SMARTBOOK SPECIAL OFFER</span>

            <h2>SALE OFF <span>50%</span></h2>

            <p>
                Ưu đãi đặc biệt dành cho những người yêu sách.
                Khám phá kho tàng tri thức và lựa chọn
                cuốn sách yêu thích với mức ưu đãi hấp dẫn.
            </p>

            <a href="#danh-sach-sach" class="sale-button">
                MUA SÁCH NGAY →
            </a>
        </div>

        <div class="sale-percent">
            50%
            <small>OFF</small>
        </div>
    </section>

    <!-- Banner giới thiệu -->
    <section class="books-hero">
        <small>SMARTBOOK COLLECTION</small>

        <h1>Mỗi cuốn sách, một thế giới mới</h1>

        <p>
            Khám phá kho tàng tri thức phong phú tại SmartBook.
            Từ những tác phẩm văn học kinh điển đến sách kỹ năng,
            giáo dục và thiếu nhi, mỗi trang sách đều mở ra
            một hành trình khám phá mới.
        </p>

        <div class="hero-quote">
            “Đọc sách hôm nay, kiến tạo tương lai ngày mai.”
        </div>
    </section>

    <!-- Danh mục -->
    <div class="books-heading">
        <h2>Khám phá theo thể loại</h2>
        <p>Lựa chọn thể loại phù hợp với sở thích và nhu cầu của bạn.</p>
    </div>

    <div class="category-list" id="danh-sach-sach">

        <a href="@Url.Action("Index", "Products")"
           class="category-item @(selectedCategory == null ? "active" : "")">
            Tất cả sách
        </a>

        @if (categories != null)
        {
            foreach (var category in categories)
            {
                <a href="@Url.Action("Index", "Products",
                    new { categoryId = category.category_id })"
                   class="category-item @(selectedCategory == category.category_id ? "active" : "")">
                    @category.category_name
                </a>
            }
        }
    </div>

    <!-- Danh sách sách -->
    @if (Model != null && Model.Any())
    {
        var groups = Model.GroupBy(x =>
            x.category == null
                ? "Sách khác"
                : x.category.category_name);

        foreach (var group in groups)
        {
            string quote = "Mỗi trang sách là một cơ hội để khám phá điều mới.";
            string message = "Hãy dành thời gian đọc sách mỗi ngày để phát triển bản thân.";

            if (group.Key.Contains("Văn học"))
            {
                quote = "Văn học giúp ta sống thêm nhiều cuộc đời.";
                message = "Đắm mình trong những câu chuyện, cảm nhận tình yêu, cuộc sống và những giá trị nhân văn.";
            }
            else if (group.Key.Contains("Kỹ năng"))
            {
                quote = "Thay đổi tư duy là bước đầu tiên để thay đổi cuộc đời.";
                message = "Mỗi kiến thức mới là một công cụ giúp bạn tự tin hơn trong học tập, công việc và cuộc sống.";
            }
            else if (group.Key.Contains("Thiếu nhi"))
            {
                quote = "Một cuốn sách hay có thể gieo một ước mơ đẹp.";
                message = "Nuôi dưỡng trí tưởng tượng, lòng nhân ái và niềm yêu thích khám phá từ những trang sách đầu đời.";
            }
            else if (group.Key.Contains("Giáo dục"))
            {
                quote = "Học tập là hành trình không có điểm kết thúc.";
                message = "Tích lũy kiến thức mỗi ngày để phát triển tư duy, kỹ năng và mở rộng cơ hội tương lai.";
            }

            <section class="book-section">

                <div class="category-title">
                    <h3>@group.Key</h3>
                    <span>@group.Count() sản phẩm</span>
                </div>

                <div class="category-message">
                    <div class="quote">“@quote”</div>
                    <p>@message</p>
                </div>

                <div class="book-grid">

                    @foreach (var book in group)
                    {
                        var bookTitle = (book.book_title ?? "").Trim().ToLowerInvariant();
                        var image = book.cover_image_url;

                        if (bookTitle == "hạ đỏ")
                        {
                            image = "~/Images/hado.jpg";
                        }
                        else if (bookTitle == "mùa hè không tên")
                        {
                            image = "~/Images/muahekhongtenvaqua.jpg";
                        }
                        else if (bookTitle == "ngày xưa có một chuyện tình")
                        {
                            image = "~/Images/ngayxuacomotchuyentinh.jpg";
                        }
                        else if (bookTitle == "ngồi khóc trên cây")
                        {
                            image = "~/Images/ngoikhoctrencay.jpg";
                        }
                        else if (bookTitle == "tiệm sách của nàng")
                        {
                            image = "~/Images/tiemsachcuanang.jpg";
                        }
                        else if (bookTitle == "tôi thấy hoa vàng trên cỏ xanh")
                        {
                            image = "~/Images/toithayhoavangtrencoxanh.jpg";
                        }

                        if (string.IsNullOrWhiteSpace(image))
                        {
                            image = Url.Content("~/Images/nen.jpg");
                        }
                        else
                        {
                            image = image.Trim();

                            if (image.StartsWith("~/"))
                            {
                                image = Url.Content(image);
                            }
                            else if (image.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
                                  || image.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
                                  || image.StartsWith("/", StringComparison.Ordinal))
                            {

                            }
                            else if (image.StartsWith("Images/", StringComparison.OrdinalIgnoreCase))
                            {
                                image = Url.Content("~/" + image);
                            }
                            else
                            {
                                image = Url.Content("~/Images/" + image);
                            }
                        }

                        var authorName = "Đang cập nhật tác giả";

                        if (authorsByBook != null &&
                            authorsByBook.ContainsKey(book.book_id))
                        {
                            authorName = authorsByBook[book.book_id];
                        }

                        int discount = 0;

                        if (book.original_price > 0 &&
                            book.sale_price < book.original_price)
                        {
                            discount = (int)Math.Round(
                                (1 - (decimal)book.sale_price /
                                (decimal)book.original_price) * 100
                            );
                        }

                        <div class="book-card">

                            <!-- Một ảnh bìa duy nhất -->
                            <a href="@Url.Action("Details", "Products",
                                new { id = book.book_id })"
                               class="book-cover">

                                <img src="@image"
                                     alt="@book.book_title"
                                     onerror="this.onerror=null;this.src='@Url.Content("~/Images/nen.jpg")';" />

                            </a>

                            <!-- Thông tin sách -->
                            <div class="book-detail">

                                <h4>@book.book_title</h4>

                                <div class="book-author">
                                    <i class="fa-solid fa-pen-nib"></i>
                                    <span>@authorName</span>
                                </div>

                                <p class="book-description">
                                    @book.description
                                </p>

                                <div class="book-price">
                                    @String.Format("{0:N0} đ", book.sale_price)
                                </div>

                                <div class="book-original-price">
                                    Giá gốc: @String.Format("{0:N0} đ", book.original_price)
                                </div>

                                @if (discount > 0)
                                {
                                    <span class="discount-label">
                                        Giảm @discount%
                                    </span>
                                }

                                <div class="book-actions">

                                    @using (Html.BeginForm("Add", "Cart", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("id", book.book_id)
                                        @Html.Hidden("quantity", 1)

                                        <button type="submit" class="add-cart-btn">
                                            <i class="fa-solid fa-cart-plus"></i>
                                            Thêm vào giỏ hàng
                                        </button>
                                    }

                                    <a href="@Url.Action("Details", "Products",
                                        new { id = book.book_id })"
                                       class="book-button">
                                        Xem chi tiết
                                        <i class="fa-solid fa-arrow-right"></i>
                                    </a>

                                </div>
                            </div>
                        </div>
                    }

                </div>
            </section>
        }
    }
    else
    {
        <div class="empty-books">
            <h3>Chưa có sách trong danh mục này</h3>

            <p>
                Hãy quay lại sau để khám phá thêm những cuốn sách mới nhé!
            </p>

            <a href="@Url.Action("Index", "Products")"
               class="book-button">
                Xem tất cả sách
            </a>
        </div>
    }

</div>
